{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./dist",
    "resolveJsonModule": true,
  },
  "include": ["src", "data"],
  "exclude": ["node_modules", "netlify", "client"],
}
